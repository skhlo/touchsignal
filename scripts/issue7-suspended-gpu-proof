#!/usr/bin/env bash
#
# A wizard — walks a human through a manual procedure step by step.
# Generated by the /wizard skill.
#
# Everything above the "STAGES" marker is the wizard library: do not hand-edit
# it. Author the per-step stages below the marker.

set -euo pipefail

# ──────────────────────────────────────────────────────────────────────────
# Wizard library — delightful, consistent UX. Identical across every wizard.
# ──────────────────────────────────────────────────────────────────────────

if [[ -t 1 ]] && command -v tput >/dev/null 2>&1 && [[ "$(tput colors 2>/dev/null || echo 0)" -ge 8 ]]; then
  BOLD=$(tput bold); DIM=$(tput dim); RESET=$(tput sgr0)
  BLUE=$(tput setaf 4); GREEN=$(tput setaf 2); YELLOW=$(tput setaf 3); RED=$(tput setaf 1)
else
  BOLD=""; DIM=""; RESET=""; BLUE=""; GREEN=""; YELLOW=""; RED=""
fi

# Author sets this at the top of the stages section.
TOTAL_STAGES=0

_STAGE_INDEX=0
ENV_FILE="${ENV_FILE:-.env}"
WRITTEN_ENV=()    # KEYs written to ENV_FILE this run
WRITTEN_SECRET=() # secret NAMEs set this run
SKIPPED=()        # things we couldn't do (e.g. gh missing)

# _clear — wipe the terminal so only the current step is on screen. No-op when
# output isn't a terminal, so piped logs stay readable.
_clear() {
  [[ -t 1 ]] || return 0
  if command -v tput >/dev/null 2>&1; then tput clear; else printf '\033[2J\033[3J\033[H'; fi
}

# banner "Title" — opening frame: what this wizard does.
banner() {
  _clear
  printf '\n%s%s  %s%s\n' "$BOLD" "$BLUE" "$1" "$RESET"
  printf '%s  %s stages%s\n\n' "$DIM" "$TOTAL_STAGES" "$RESET"
  printf '%s  You drive the browser; this wizard tells you exactly what to do and\n' "$DIM"
  printf '  captures the values you copy back. Stop any time with Ctrl-C and re-run\n'
  printf '  later — it remembers values already saved.%s\n' "$RESET"
  pause "Ready to start?"
}

# stage "Name" — clear the screen, then announce a stage and show progress.
# Clearing keeps only the current step on screen.
stage() {
  _clear
  _STAGE_INDEX=$((_STAGE_INDEX + 1))
  printf '\n%s%s▸ Stage %s/%s · %s%s\n' \
    "$BOLD" "$BLUE" "$_STAGE_INDEX" "$TOTAL_STAGES" "$1" "$RESET"
}

# say "..." — a plain instruction line.
say()  { printf '  %s\n' "$1"; }
# step "..." — a numbered-feeling action the human takes in the browser.
step() { printf '  %s•%s %s\n' "$BLUE" "$RESET" "$1"; }
note() { printf '  %s%s%s\n' "$DIM" "$1" "$RESET"; }
warn() { printf '  %s⚠ %s%s\n' "$YELLOW" "$1" "$RESET"; }

# open_url URL — open in the human's browser, cross-platform incl. WSL.
open_url() {
  local url="$1"
  printf '  %s↗ opening%s %s\n' "$GREEN" "$RESET" "$url"
  { if   command -v wslview     >/dev/null 2>&1; then wslview "$url"
    elif command -v explorer.exe >/dev/null 2>&1; then explorer.exe "$url"
    elif command -v xdg-open    >/dev/null 2>&1; then xdg-open "$url"
    elif command -v open        >/dev/null 2>&1; then open "$url"
    else warn "couldn't open a browser — visit it manually: $url"; fi
  } >/dev/null 2>&1 || warn "couldn't open a browser — visit it manually: $url"
}

# pause "msg" — wait for the human to confirm they've done the manual part.
pause() {
  printf '  %s%s%s ' "$DIM" "${1:-Press Enter to continue}" "$RESET"
  read -r _ || true
}

# confirm "question" — y/N gate; returns success on yes.
confirm() {
  local reply=""
  printf '  %s? %s [y/N] ' "$YELLOW" "$1"
  read -r reply || true
  [[ "$reply" =~ ^[Yy] ]]
}

# _existing KEY — current value of KEY in ENV_FILE, if any.
_existing() {
  [[ -f "$ENV_FILE" ]] || return 1
  local line; line=$(grep -E "^${1}=" "$ENV_FILE" | tail -n1) || return 1
  printf '%s' "${line#*=}"
}

# ask KEY "Prompt" — read a value into $KEY. Offers the existing .env value as
# a default on re-runs (Enter keeps it). Visible input (non-secret).
ask() {
  local key="$1" prompt="$2" current input
  current=$(_existing "$key" || true)
  if [[ -n "$current" ]]; then
    printf '  %s%s%s %s[Enter keeps current]%s ' "$BOLD" "$prompt" "$RESET" "$DIM" "$RESET"
  else
    printf '  %s%s%s ' "$BOLD" "$prompt" "$RESET"
  fi
  read -r input || true
  [[ -z "$input" && -n "$current" ]] && input="$current"
  printf -v "$key" '%s' "$input"
}

# ask_secret KEY "Prompt" — like ask, but input is hidden.
ask_secret() {
  local key="$1" prompt="$2" current input
  current=$(_existing "$key" || true)
  if [[ -n "$current" ]]; then
    printf '  %s%s%s %s[Enter keeps current]%s ' "$BOLD" "$prompt" "$RESET" "$DIM" "$RESET"
  else
    printf '  %s%s%s ' "$BOLD" "$prompt" "$RESET"
  fi
  read -rs input || true
  printf '\n'
  [[ -z "$input" && -n "$current" ]] && input="$current"
  printf -v "$key" '%s' "$input"
}

# write_env KEY VALUE — upsert KEY=VALUE into ENV_FILE (creates it; replaces
# any existing line). Idempotent.
write_env() {
  local key="$1" value="$2" tmp
  touch "$ENV_FILE"
  tmp=$(mktemp)
  grep -vE "^${key}=" "$ENV_FILE" > "$tmp" || true
  printf '%s=%s\n' "$key" "$value" >> "$tmp"
  mv "$tmp" "$ENV_FILE"
  WRITTEN_ENV+=("$key")
  printf '  %s✓ wrote%s %s → %s\n' "$GREEN" "$RESET" "$key" "$ENV_FILE"
}

# set_secret NAME VALUE — set a GitHub Actions repo secret via gh. Falls back
# to a warning (and records it) if gh is unavailable or unauthenticated.
set_secret() {
  local name="$1" value="$2"
  if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
    if printf '%s' "$value" | gh secret set "$name" >/dev/null 2>&1; then
      WRITTEN_SECRET+=("$name")
      printf '  %s✓ set%s GitHub secret %s\n' "$GREEN" "$RESET" "$name"
      return
    fi
  fi
  SKIPPED+=("GitHub secret $name (set it manually: gh secret set $name)")
  warn "skipped GitHub secret $name — gh not ready; set it later"
}

# set_var NAME VALUE — set a GitHub Actions repo variable (non-secret).
set_var() {
  local name="$1" value="$2"
  if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
    if gh variable set "$name" --body "$value" >/dev/null 2>&1; then
      printf '  %s✓ set%s GitHub variable %s\n' "$GREEN" "$RESET" "$name"
      return
    fi
  fi
  SKIPPED+=("GitHub variable $name")
  warn "skipped GitHub variable $name — gh not ready; set it later"
}

# finish — clear, then a closing summary of everything configured.
finish() {
  _clear
  printf '\n%s%s  ✓ Setup complete%s\n' "$BOLD" "$GREEN" "$RESET"
  (( ${#WRITTEN_ENV[@]} ))    && note "wrote ${#WRITTEN_ENV[@]} value(s) to $ENV_FILE: ${WRITTEN_ENV[*]}"
  (( ${#WRITTEN_SECRET[@]} )) && note "set ${#WRITTEN_SECRET[@]} GitHub secret(s): ${WRITTEN_SECRET[*]}"
  if (( ${#SKIPPED[@]} )); then
    printf '\n'; warn "still to do by hand:"
    for s in "${SKIPPED[@]}"; do note "  - $s"; done
  fi
  printf '\n'
}

# ──────────────────────────────────────────────────────────────────────────
# STAGES — author this section. One stage() per step the human takes.
# Replace the example below. Set TOTAL_STAGES to match the stages you write.
# ──────────────────────────────────────────────────────────────────────────

TOTAL_STAGES=8

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
ISSUE_ROOT=$(cd -- "$SCRIPT_DIR/.." && pwd)
STATE_DIR="$ISSUE_ROOT/.scratch"
STATE_FILE="$STATE_DIR/issue7-safe-proof.state"
RESULT_FILE="$STATE_DIR/issue7-safe-proof-result.json"
BACKUP_FILE="$STATE_DIR/issue7-safe-env-hyprland.backup"
BACKUP_MARKER="$STATE_DIR/issue7-safe-env-hyprland.original"
ORIGINAL_RUNPM_FILE="$STATE_DIR/issue7-safe-original-runpm"
ORIGINAL_SESSION_GPU_FILE="$STATE_DIR/issue7-safe-original-session-gpu"
PROBE_SCRIPT="$SCRIPT_DIR/issue7-suspended-gpu-probe"
MODULES_LOAD_SOURCE="$ISSUE_ROOT/systemd/modules-load.d/touchsignal.conf"
MODULES_LOAD_TARGET="/etc/modules-load.d/touchsignal.conf"
UWSM_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/uwsm"
UWSM_ENV_FILE="$UWSM_DIR/env-hyprland"
FORCED_PARAMETER="amdgpu.runpm=1"
RUNPM_FILE="/sys/module/amdgpu/parameters/runpm"
IGPU_PCI="0000:00:02.0"
DGPU_PCI="0000:03:00.0"

state_value() {
  if [[ -f "$STATE_FILE" ]]; then
    tr -d '\n' < "$STATE_FILE"
  fi
}

write_state() {
  printf '%s\n' "$1" > "$STATE_FILE"
}

cmdline_has() {
  local token
  while read -r token; do
    [[ "$token" == "$1" ]] && return 0
  done < <(tr ' ' '\n' < /proc/cmdline)
  return 1
}

resolve_drm_node() {
  local pci="$1" card name resolved match=""
  for card in /sys/class/drm/card[0-9]*; do
    [[ -e "$card" ]] || continue
    name=${card##*/}
    [[ "${name#card}" =~ ^[0-9]+$ ]] || continue
    resolved=$(basename "$(readlink -f "$card/device")")
    [[ "$resolved" == "$pci" ]] || continue
    [[ -z "$match" ]] || return 1
    match="/dev/dri/$name"
  done
  [[ -n "$match" && -e "$match" ]] || return 1
  printf '%s\n' "$match"
}

verify_gpu_identity() {
  local pci="$1" vendor="$2" node
  [[ "$(< "/sys/bus/pci/devices/$pci/vendor")" == "$vendor" ]] || return 1
  node=$(resolve_drm_node "$pci") || return 1
  [[ "$(basename "$(readlink -f "/sys/class/drm/${node##*/}/device")")" == "$pci" ]]
}

live_hyprland_signature() {
  local instances
  instances=$(hyprctl instances -j) || return 1
  python3 -c '
import json
import sys

instances = json.load(sys.stdin)
if len(instances) != 1:
    raise SystemExit(1)
signature = instances[0].get("instance")
if not isinstance(signature, str) or not signature:
    raise SystemExit(1)
print(signature)
' <<< "$instances"
}

healthy_monitor_count() {
  local signature monitors
  signature=$(live_hyprland_signature) || return 1
  monitors=$(hyprctl --instance "$signature" monitors all -j) || return 1
  python3 -c '
import json
import sys

monitors = json.load(sys.stdin)
print(sum(
    not monitor.get("disabled", False)
    and monitor.get("width", 0) > 0
    and monitor.get("height", 0) > 0
    and bool(monitor.get("availableModes"))
    for monitor in monitors
))
' <<< "$monitors"
}

session_gpu_value() {
  systemctl --user show-environment \
    | sed -n 's/^AQ_DRM_DEVICES=//p' \
    | tail -n 1
}

touchsignal_ready() {
  [[ -e /dev/uinput && -w /dev/uinput ]] \
    && systemctl --user is-active --quiet touchsignal-touchbar-owner.service \
    && systemctl --user show touchsignal-touchbar-owner.service -p ExecStart --value \
      | grep -Fq "$ISSUE_ROOT/scripts/touchbar-owner"
}

boot_prerequisite_ready() {
  [[ -f "$MODULES_LOAD_SOURCE" && -f "$MODULES_LOAD_TARGET" ]] \
    && cmp -s -- "$MODULES_LOAD_SOURCE" "$MODULES_LOAD_TARGET"
}

backup_uwsm_environment() {
  mkdir -p -- "$UWSM_DIR"
  [[ -w "$UWSM_DIR" ]] || return 1
  [[ ! -e "$BACKUP_MARKER" && ! -e "$BACKUP_FILE" ]] || return 1
  if [[ -f "$UWSM_ENV_FILE" ]]; then
    cp -a -- "$UWSM_ENV_FILE" "$BACKUP_FILE"
    printf 'present\n' > "$BACKUP_MARKER"
  else
    printf 'absent\n' > "$BACKUP_MARKER"
  fi
  session_gpu_value > "$ORIGINAL_SESSION_GPU_FILE"
}

write_dynamic_igpu_environment() {
  local temporary
  temporary=$(mktemp "$UWSM_DIR/.env-hyprland.XXXXXX")
  if [[ -f "$UWSM_ENV_FILE" ]]; then
    cp -- "$UWSM_ENV_FILE" "$temporary"
  fi
  {
    printf '\n# Temporary TouchSignal suspended-dGPU proof.\n'
    printf '%s\n' 'unset AQ_DRM_DEVICES'
    printf '%s\n' 'touchsignal_igpu_card=' \
      'for touchsignal_card_path in /sys/class/drm/card[0-9]*; do' \
      "  touchsignal_card_name=\${touchsignal_card_path##*/}" \
      "  touchsignal_card_number=\${touchsignal_card_name#card}" \
      "  case \$touchsignal_card_number in" \
      "    ''|*[!0-9]*) continue ;;" \
      '  esac' \
      "  touchsignal_card_pci=\$(basename \"\$(readlink -f \"\$touchsignal_card_path/device\")\")" \
      "  if [ \"\$touchsignal_card_pci\" = \"$IGPU_PCI\" ]; then" \
      "    touchsignal_igpu_card=\$touchsignal_card_name" \
      '    break' \
      '  fi' \
      'done' \
      "if [ -n \"\$touchsignal_igpu_card\" ]; then" \
      "  export AQ_DRM_DEVICES=\"/dev/dri/\$touchsignal_igpu_card\"" \
      'fi' \
      'unset touchsignal_igpu_card touchsignal_card_path touchsignal_card_name' \
      'unset touchsignal_card_number touchsignal_card_pci'
  } >> "$temporary"
  chmod 600 "$temporary"
  mv -- "$temporary" "$UWSM_ENV_FILE"
}

restore_uwsm_environment() {
  local original
  original=$(tr -d '\n' < "$BACKUP_MARKER")
  if [[ "$original" == "present" ]]; then
    cp -- "$BACKUP_FILE" "$UWSM_ENV_FILE"
  elif [[ "$original" == "absent" ]]; then
    rm -f -- "$UWSM_ENV_FILE"
  else
    warn "unknown UWSM backup marker: $original"
    return 1
  fi
}

verify_original_uwsm_environment() {
  local original
  original=$(tr -d '\n' < "$BACKUP_MARKER")
  if [[ "$original" == "present" ]]; then
    cmp -s -- "$BACKUP_FILE" "$UWSM_ENV_FILE"
  elif [[ "$original" == "absent" ]]; then
    [[ ! -e "$UWSM_ENV_FILE" ]]
  else
    return 1
  fi
}

show_one_boot_edit() {
  step "When Limine appears, press any key to stop automatic boot."
  step "Open Omarchy, highlight linux-t2, and press e."
  step "On the cmdline line only, append: $FORCED_PARAMETER"
  step "Press F10 to boot. This edit lasts for that boot only."
}

rerun_instruction() {
  say "After signing back in, open a terminal and rerun:"
  say "  $SCRIPT_DIR/issue7-suspended-gpu-proof"
}

reboot_now() {
  rerun_instruction
  exec omarchy system reboot >/dev/null 2>&1
}

logout_now() {
  rerun_instruction
  exec omarchy system logout >/dev/null 2>&1
}

cleanup_state() {
  rm -f -- "$BACKUP_FILE" "$BACKUP_MARKER" "$ORIGINAL_RUNPM_FILE" \
    "$ORIGINAL_SESSION_GPU_FILE" "$STATE_FILE"
}

restore_and_offer_normal_reboot() {
  restore_uwsm_environment
  if [[ -f "$RESULT_FILE" ]]; then
    write_state "awaiting_normal_boot"
  else
    write_state "awaiting_normal_boot_no_result"
  fi
  stage "Restore the normal boot and compositor"
  say "The original UWSM environment is restored on disk."
  step "Allow Limine to boot normally. Do not press e."
  if confirm "Reboot back into the normal session now?"; then
    reboot_now
  fi
  say "Rerun this wizard when ready; it will offer the normal reboot again."
  exit 1
}

banner "TouchSignal staged suspended-dGPU acceptance"

mkdir -p -- "$STATE_DIR"

STATE=$(state_value)

case "$STATE" in
  "")
    stage "Preflight the normal session"
    for command in cmp fuser git hyprctl modinfo omarchy pkexec python3 readlink systemctl; do
      if ! command -v "$command" >/dev/null 2>&1; then
        warn "required command is missing: $command"
        exit 1
      fi
    done
    [[ -x "$PROBE_SCRIPT" ]] || {
      warn "probe is not executable: $PROBE_SCRIPT"
      exit 1
    }
    [[ -z "$(git -C "$ISSUE_ROOT" status --porcelain --untracked-files=no)" ]] || {
      warn "the integrated issue-7 worktree has tracked changes"
      exit 1
    }
    if git -C "$ISSUE_ROOT" rev-parse -q --verify MERGE_HEAD >/dev/null; then
      warn "the issue-7 worktree still has an active merge"
      exit 1
    fi
    grep -Fq '1 = force enable with BACO' < <(modinfo -p amdgpu) || {
      warn "this amdgpu module does not describe runpm=1 as forced BACO"
      exit 1
    }
    cmdline_has "$FORCED_PARAMETER" && {
      warn "$FORCED_PARAMETER is already active; start from a normal boot"
      exit 1
    }
    verify_gpu_identity "$IGPU_PCI" "0x8086" || {
      warn "the Intel iGPU could not be resolved from PCI identity"
      exit 1
    }
    verify_gpu_identity "$DGPU_PCI" "0x1002" || {
      warn "the AMD dGPU could not be resolved from PCI identity"
      exit 1
    }
    [[ "$(healthy_monitor_count)" == "1" ]] || {
      warn "the normal Hyprland session does not have one healthy internal monitor"
      exit 1
    }
    touchsignal_ready || {
      warn "TouchSignal or /dev/uinput is not ready"
      exit 1
    }
    boot_prerequisite_ready || {
      warn "the uinput boot prerequisite is not installed byte-for-byte"
      say "Install it before any further reboot:"
      say "  sudo install -Dm0644 $MODULES_LOAD_SOURCE $MODULES_LOAD_TARGET"
      exit 1
    }
    if [[ -e "$BACKUP_MARKER" || -e "$BACKUP_FILE" \
      || -e "$ORIGINAL_RUNPM_FILE" || -e "$ORIGINAL_SESSION_GPU_FILE" ]]; then
      warn "a previous safe-proof backup exists without a state marker; do not overwrite it"
      exit 1
    fi
    tr -d '\n' < "$RUNPM_FILE" > "$ORIGINAL_RUNPM_FILE"
    printf '\n' >> "$ORIGINAL_RUNPM_FILE"
    write_state "awaiting_forced_boot"
    say "Normal graphics, both PCI GPU identities, TouchSignal, and uinput are healthy."
    say "No compositor configuration has been changed."

    stage "Reboot with forced BACO only"
    warn "This reboot does not install an AQ_DRM_DEVICES override."
    show_one_boot_edit
    confirm "I have read the one-boot Limine steps. Reboot now?" || {
      say "Rerun this wizard when ready. No graphics configuration was changed."
      exit 0
    }
    reboot_now
    ;;

  awaiting_forced_boot)
    _STAGE_INDEX=2
    stage "Verify forced runtime PM before graphics changes"
    if ! cmdline_has "$FORCED_PARAMETER"; then
      warn "the one-boot $FORCED_PARAMETER edit is not active"
      say "No compositor configuration was changed, so this session is safe."
      show_one_boot_edit
      if confirm "Retry the one-boot Limine edit now?"; then
        reboot_now
      fi
      if confirm "Cancel this proof and remove its state marker?"; then
        cleanup_state
      fi
      exit 1
    fi
    if [[ "$(< "$RUNPM_FILE")" != "1" ]]; then
      warn "the kernel command line contains $FORCED_PARAMETER, but amdgpu reports another value"
      write_state "awaiting_normal_boot_no_uwsm"
      say "No compositor configuration was changed."
      exit 1
    fi
    boot_prerequisite_ready || {
      warn "the uinput boot prerequisite changed after reboot"
      exit 1
    }
    touchsignal_ready || {
      warn "TouchSignal or /dev/uinput is not ready after reboot"
      say "No compositor configuration was changed. Restore TouchSignal, then rerun."
      exit 1
    }
    [[ "$(healthy_monitor_count)" == "1" ]] || {
      warn "the normal compositor is not healthy; no override will be written"
      exit 1
    }
    verify_gpu_identity "$IGPU_PCI" "0x8086" || {
      warn "the Intel iGPU identity is unavailable in this boot"
      exit 1
    }
    verify_gpu_identity "$DGPU_PCI" "0x1002" || {
      warn "the AMD dGPU identity is unavailable in this boot"
      exit 1
    }
    say "Forced BACO and the untouched normal compositor are verified."

    stage "Prepare one dynamic iGPU-only session"
    warn "The override resolves Intel PCI $IGPU_PCI each time UWSM sources it."
    warn "No DRM card number is stored across a reboot."
    if ! confirm "Back up UWSM and write the temporary dynamic override?"; then
      write_state "awaiting_normal_boot_no_uwsm"
      exit 0
    fi
    backup_uwsm_environment || {
      warn "the UWSM environment could not be backed up safely"
      exit 1
    }
    write_dynamic_igpu_environment || {
      warn "the dynamic UWSM environment could not be written"
      restore_uwsm_environment
      write_state "awaiting_normal_boot_no_result"
      exit 1
    }
    write_state "awaiting_igpu_login"
    say "The dynamic iGPU-only environment is ready."

    stage "Log out into the iGPU-only session"
    warn "This closes application windows, including Herdr and coding agents."
    confirm "Log out now?" || {
      say "Rerun this wizard when ready; the dynamic override is prepared."
      exit 0
    }
    logout_now
    ;;

  awaiting_igpu_login)
    _STAGE_INDEX=5
    stage "Verify the iGPU session and run the proof"
    if ! cmdline_has "$FORCED_PARAMETER"; then
      warn "the forced parameter disappeared, so the probe will not run"
      restore_uwsm_environment
      write_state "awaiting_normal_boot_no_result"
      say "The original UWSM environment is restored. Log out once and rerun."
      confirm "Log out now?" && logout_now
      exit 1
    fi
    IGPU_NODE=$(resolve_drm_node "$IGPU_PCI") || {
      warn "the Intel iGPU cannot be resolved in this boot"
      restore_and_offer_normal_reboot
    }
    if [[ "$(session_gpu_value)" != "$IGPU_NODE" ]]; then
      warn "this session is not using the resolved Intel node $IGPU_NODE"
      say "If you have not logged out since Stage 4, do that now."
      confirm "Log out into the prepared iGPU-only session now?" && logout_now
      exit 1
    fi
    [[ "$(healthy_monitor_count)" == "1" ]] || {
      warn "the iGPU-only compositor does not have one healthy monitor"
      restore_and_offer_normal_reboot
    }
    DGPU_NODE=$(resolve_drm_node "$DGPU_PCI") || {
      warn "the AMD dGPU cannot be resolved in this boot"
      restore_and_offer_normal_reboot
    }
    HOLDERS=$(fuser "$DGPU_NODE" 2>/dev/null || true)
    if [[ -n "$HOLDERS" ]]; then
      warn "the dGPU still has open device holders: $HOLDERS"
      say "No process was terminated and the probe did not run."
      restore_and_offer_normal_reboot
    fi
    touchsignal_ready || {
      warn "TouchSignal is not healthy in the iGPU-only session"
      restore_and_offer_normal_reboot
    }
    say "Forced BACO, a healthy Intel-only compositor, and zero dGPU holders are verified."
    say "Polkit will request permission for one reversible runtime-PM probe."
    PROBE_JSON=""
    PROBE_EXIT=0
    if PROBE_JSON=$(pkexec env "PYTHONPATH=$ISSUE_ROOT/src" python3 "$PROBE_SCRIPT"); then
      PROBE_EXIT=0
    else
      PROBE_EXIT=$?
    fi
    if python3 -c 'import json,sys; json.load(sys.stdin)' <<< "$PROBE_JSON"; then
      printf '%s\n' "$PROBE_JSON" > "$RESULT_FILE"
    else
      printf '{"error":"probe did not return valid JSON","exit_code":%s,"success":false}\n' "$PROBE_EXIT" > "$RESULT_FILE"
    fi
    PROBE_SUCCESS=$(python3 -c 'import json,sys; result=json.load(open(sys.argv[1], encoding="utf-8")); print("yes" if result.get("success") else "no")' "$RESULT_FILE")
    restore_uwsm_environment
    write_state "awaiting_normal_boot"
    if [[ "$PROBE_SUCCESS" == "yes" ]]; then
      say "Suspended runtime and zero GPU sensor accesses are verified."
    else
      warn "the suspended-dGPU proof failed; the probe restored power control"
    fi
    say "Evidence: $RESULT_FILE"

    stage "Restore the normal boot and compositor"
    say "The original UWSM environment is restored on disk."
    step "Allow Limine to boot normally. Do not press e."
    confirm "Reboot back into the normal session now?" || {
      say "Rerun this wizard when ready; it will offer the normal reboot again."
      exit 0
    }
    reboot_now
    ;;

  awaiting_normal_boot)
    if cmdline_has "$FORCED_PARAMETER"; then
      _STAGE_INDEX=6
      stage "Restore the normal boot and compositor"
      say "The original UWSM environment is already restored on disk."
      step "Allow Limine to boot normally. Do not press e."
      confirm "Reboot back into the normal session now?" || exit 0
      reboot_now
    fi

    _STAGE_INDEX=7
    stage "Verify restoration and acceptance evidence"
    ORIGINAL_RUNPM=$(tr -d '\n' < "$ORIGINAL_RUNPM_FILE")
    [[ "$(< "$RUNPM_FILE")" == "$ORIGINAL_RUNPM" ]] || {
      warn "amdgpu runpm did not return to its original value"
      exit 1
    }
    verify_original_uwsm_environment || {
      warn "the original UWSM environment was not restored byte-for-byte"
      exit 1
    }
    ORIGINAL_SESSION_GPU=$(tr -d '\n' < "$ORIGINAL_SESSION_GPU_FILE")
    [[ "$(session_gpu_value)" == "$ORIGINAL_SESSION_GPU" ]] || {
      warn "the original compositor GPU environment was not restored"
      exit 1
    }
    [[ "$(healthy_monitor_count)" == "1" ]] || {
      warn "the normal compositor monitor is not healthy"
      exit 1
    }
    touchsignal_ready || {
      warn "TouchSignal or /dev/uinput is not healthy after restoration"
      exit 1
    }
    PROBE_SUCCESS=$(python3 -c 'import json,sys; result=json.load(open(sys.argv[1], encoding="utf-8")); print("yes" if result.get("success") else "no")' "$RESULT_FILE")
    say "The normal kernel, compositor, and TouchSignal service are restored."
    say "Acceptance evidence: $RESULT_FILE"
    if [[ "$PROBE_SUCCESS" == "yes" ]]; then
      write_state "completed"
      say "The suspended-dGPU acceptance proof passed."
    else
      write_state "failed_restored"
      warn "The proof failed, but every temporary system change was restored."
    fi
    if confirm "Remove the temporary backups and state marker?"; then
      cleanup_state
      say "Temporary backup and state files removed; the result is retained."
    fi
    finish
    ;;

  awaiting_normal_boot_no_uwsm)
    _STAGE_INDEX=6
    stage "Return from the forced boot without graphics changes"
    if cmdline_has "$FORCED_PARAMETER"; then
      step "Allow Limine to boot normally. Do not press e."
      confirm "Reboot normally now?" || exit 0
      reboot_now
    fi
    say "Normal runtime PM is restored. No UWSM override was created."
    cleanup_state
    finish
    ;;

  awaiting_normal_boot_no_result)
    _STAGE_INDEX=6
    stage "Restore normal graphics after an aborted proof"
    if cmdline_has "$FORCED_PARAMETER"; then
      step "Allow Limine to boot normally. Do not press e."
      confirm "Reboot normally now?" || exit 0
      reboot_now
    fi
    ORIGINAL_RUNPM=$(tr -d '\n' < "$ORIGINAL_RUNPM_FILE")
    [[ "$(< "$RUNPM_FILE")" == "$ORIGINAL_RUNPM" ]] || {
      warn "amdgpu runpm did not return to its original value"
      exit 1
    }
    verify_original_uwsm_environment || {
      warn "the original UWSM environment was not restored byte-for-byte"
      exit 1
    }
    ORIGINAL_SESSION_GPU=$(tr -d '\n' < "$ORIGINAL_SESSION_GPU_FILE")
    [[ "$(session_gpu_value)" == "$ORIGINAL_SESSION_GPU" ]] || {
      warn "the original compositor GPU environment was not restored"
      say "Log out once, sign back in, and rerun this wizard."
      exit 1
    }
    [[ "$(healthy_monitor_count)" == "1" ]] || {
      warn "the normal compositor monitor is not healthy"
      exit 1
    }
    touchsignal_ready || {
      warn "TouchSignal or /dev/uinput is not healthy after restoration"
      exit 1
    }
    say "Normal graphics and TouchSignal are restored; the hardware probe did not run."
    cleanup_state
    finish
    ;;

  completed)
    _STAGE_INDEX=8
    say "The suspended-dGPU acceptance proof is complete."
    say "Evidence: $RESULT_FILE"
    confirm "Remove the temporary backups and state marker?" && cleanup_state
    finish
    ;;

  failed_restored)
    _STAGE_INDEX=8
    warn "The proof failed, but normal graphics and power control were restored."
    say "Evidence: $RESULT_FILE"
    confirm "Remove the temporary backups and state marker?" && cleanup_state
    finish
    ;;

  *)
    warn "unknown wizard state: $STATE"
    exit 1
    ;;
esac
