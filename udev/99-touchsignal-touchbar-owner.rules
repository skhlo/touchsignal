# Optional, reversible udev helper for the Touch Bar owner spike.
# Do not install this file unless the current user has approved a privileged
# USB configuration change. Remove it with the reversal procedure in
# docs/hardware/touchbar-owner-spike.md.
#
# Seat assignment is intended to keep Hyprland from becoming DRM master of
# appletbdrm. It is not installed by default and is unproven until udevadm
# info is re-read on the config-2 card and digitizer.
# ATTR{name} matches the parent input* device. ATTRS{name} matches the event*
# node, where name lives on the parent (udev(7)). The firmware keyboard named
# "Apple Inc. Touch Bar Display" stays on seat0.
# USB, backlight, and appletbdrm use group input because this session already
# has it. Do not copy tiny-dfr's automatic USB config-2 write.
SUBSYSTEM=="drm", KERNEL=="card*", ATTRS{idVendor}=="05ac", ATTRS{idProduct}=="8302", TAG-="master-of-seat", ENV{ID_SEAT}="seat-touchbar", GROUP="input", MODE="0660", RUN+="/bin/chown root:input /dev/dri/%k", RUN+="/bin/chmod 0660 /dev/dri/%k"
SUBSYSTEM=="input", KERNEL=="input*", ATTR{name}=="Apple Inc. Touch Bar Display Touchpad", ENV{ID_SEAT}="seat-touchbar"
SUBSYSTEM=="input", KERNEL=="event*", ATTRS{name}=="Apple Inc. Touch Bar Display Touchpad", ENV{ID_SEAT}="seat-touchbar"

# Config switching without a persistent root process.
ACTION=="add", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="05ac", ATTR{idProduct}=="8302", GROUP="input", MODE="0660", RUN+="/bin/chown root:input /sys%p/bConfigurationValue", RUN+="/bin/chmod g+w /sys%p/bConfigurationValue", ATTR{power/control}="on", ATTR{power/autosuspend_delay_ms}="-1"

ACTION=="add", SUBSYSTEM=="backlight", KERNEL=="appletb_backlight", RUN+="/bin/chown root:input /sys/class/backlight/%k/brightness", RUN+="/bin/chmod g+w /sys/class/backlight/%k/brightness"

SUBSYSTEM=="misc", KERNEL=="uinput", GROUP="input", MODE="0660"
